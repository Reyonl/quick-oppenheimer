{
  "name": "quick-oppenheimer",
  "version": "1.0.0",
  "description": "Oppenheimer Parody in Remotion - 'Destroyer of Production'",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts OppenheimerProduction out/video.mp4",
    "still": "remotion still src/index.ts OppenheimerProduction out/preview.png",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.0.0"
  }
}
